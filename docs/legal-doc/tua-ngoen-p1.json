          "indentFirstPt": 44,
          "spaceBeforePt": 0,
          "lines": [
            {
              "id": "b01.l01",
              "runs": [
                {
                  "text": "ข้อ ๑. นายจันทร์ออกเช็คผู้ถือลงวันที่ล่วงหน้าเตรียมไว้สำหรับชำระหนี้ค่าสินค้าแล้วทำเช็คหายไป"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b01.l02",
              "runs": [
                {
                  "text": "นายอังคารเก็บเช็คได้นำเช็คไปแลกเงินสดจากนายพุธ นายพุธไม่รู้ว่านายอังคารเก็บเช็คได้จึงรับแลกเช็คไว้โดย"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b01.l03",
              "runs": [
                {
                  "text": "ให้นายอังคารลงลายมือชื่อสลักหลังเช็คไว้ด้วย ต่อมานายจันทร์ทราบว่าเช็คอยู่ที่นายพุธจึงไปขอเช็คคืน"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b01.l04",
              "runs": [
                {
                  "text": "โดยแจ้งให้ทราบว่าเช็คดังกล่าวไม่มีมูลหนี้เพราะตนทำหายไป นายพุธไม่ยอมคืนเช็คให้ แต่กลับนำเช็คไปเรียก"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b01.l05",
              "runs": [
                {
                  "text": "เก็บเงิน ธนาคารปฏิเสธการจ่ายเงิน นายพุธได้ยื่นฟ้องนายจันทร์กับนายอังคารให้ร่วมกันรับผิดใช้เงินตามเช็ค"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b01.l06",
              "runs": [
                {
                  "text": "ทั้งสองคนต่อสู้ว่า นายพุธรู้แล้วว่าเช็คไม่มีมูลหนี้แต่ยังรับแลกเช็คไว้เป็นการคบคิดกันฉ้อฉล นายพุธไม่ใช่ผู้ทรง"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b01.l07",
              "runs": [
                {
                  "text": "โดยชอบด้วยกฎหมาย จึงไม่มีอำนาจฟ้อง ขอให้ยกฟ้อง"
                }
              ]
            }
          ],
          "fitToWidth": true
        },
        {
          "id": "b02",
          "role": "body",
          "align": "left",
          "indentFirstPt": 44,
          "spaceBeforePt": 18,
          "lines": [
            {
              "id": "b02.l01",
              "runs": [
                {
                  "text": "ให้วินิจฉัยว่า ข้อต่อสู้ของนายจันทร์และนายอังคารฟังขึ้นหรือไม่ (๒๕ คะแนน)"
                }
              ]
            }
          ],
          "fitToWidth": true
        },
        {
          "id": "b03",
          "role": "spacer",
          "bbox": {
            "h": 22
          },
          "lines": []
        },
        {
          "id": "b04",
          "role": "clause",
          "align": "justify",
          "indentFirstPt": 44,
          "spaceBeforePt": 0,
          "lines": [
            {
              "id": "b04.l01",
              "runs": [
                {
                  "text": "ข้อ ๒. นายพานไปรับประทานอาหารที่ภัตตาคารแห่งหนึ่งในจังหวัดเชียงใหม่ ได้พบกับนายทอง"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l02",
              "runs": [
                {
                  "text": "ลูกหนี้ จึงทวงถามหนี้เงินยืม นายทองได้ออกเช็คธนาคารกรุงธน จำกัด สาขาเชียงใหม่ ลงวันที่ ๑๐"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l03",
              "runs": [
                {
                  "text": "กุมภาพันธ์ ๒๕๕๐ ระบุชื่อนายพานเป็นผู้รับเงินและขีดฆ่าคำว่าผู้ถือ มอบเช็คให้แก่นายพานที่ภัตตาคาร"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l04",
              "runs": [
                {
                  "text": "แห่งนั้นเองเพื่อชำระหนี้ดังกล่าว ต่อมานายพานลงลายมือชื่อที่ด้านหลังเช็คโดยไม่เขียนข้อความใดๆ ส่งมอบ"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l05",
              "runs": [
                {
                  "text": "เช็คชำระหนี้ค่าแหวนเพชรให้แก่นายแท้ นายแท้ได้รับเช็คไว้แล้วหลงลืม จนกระทั่งวันที่ ๑๕ มีนาคม ๒๕๕๐"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l06",
              "runs": [
                {
                  "text": "จึงนำเช็คไปเรียกเก็บเงิน ธนาคารกรุงธน จำกัด สาขาเชียงใหม่ ปฏิเสธการจ่ายเงินโดยให้เหตุผลว่า เงินในบัญชี"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l07",
              "runs": [
                {
                  "text": "ไม่พอจ่าย นายแท้ทวงถามนายทองกับนายพานให้ใช้เงินตามเช็ค นายทองต่อสู้ว่า เช็คไม่ระบุชื่อนายแท้เป็น"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l08",
              "runs": [
                {
                  "text": "ผู้รับโอน การโอนไม่สมบูรณ์ นายแท้ไม่ใช่ผู้ทรง ส่วนนายพานต่อสู้ว่า นายแท้นำเช็คไปเรียกเก็บเงินล่าช้า"
                }
              ],
              "align": "justify"
            },
            {
              "id": "b04.l09",
              "runs": [
                {
                  "text": "จึงสิ้นสิทธิไล่เบี้ยเอาแก่ตน"
                }
              ]
            }
          ],
          "fitToWidth": true
        },
